---
// Temporary home page, until the portfolio is built.
import ContactPanel from '../components/organisms/ContactPanel.astro';
import IdentityPanel from '../components/organisms/IdentityPanel.astro';
import ServerStage from '../components/organisms/ServerStage.astro';
import StatusPanel from '../components/organisms/StatusPanel.astro';
import ChantierTemplate from '../components/templates/ChantierTemplate.astro';
import { PROFILE, SOCIAL_LINKS } from '../data/profile';
import { PENDING_VPS_STATUS } from '../data/vps-status';

const pageTitle = `${PROFILE.firstName} ${PROFILE.lastName} · Portfolio en construction`;
const pageDescription = `Portfolio de ${PROFILE.firstName} ${PROFILE.lastName}, ${PROFILE.className.toLowerCase()}. Site en construction.`;
const portraitAlt = `Portrait de ${PROFILE.firstName} ${PROFILE.lastName}`;
---

<ChantierTemplate title={pageTitle} description={pageDescription}>
  <IdentityPanel slot="panels" profile={PROFILE} />
  <StatusPanel slot="panels" links={SOCIAL_LINKS} portraitAlt={portraitAlt} />
  <ContactPanel slot="panels" email={PROFILE.email} />

  <ServerStage slot="stage" status={PENDING_VPS_STATUS} />
</ChantierTemplate>
