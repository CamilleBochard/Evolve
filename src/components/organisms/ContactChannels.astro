---
// Channels of the contact page: one card per way to reach me, like a list
// of fast-travel points. The email card can copy the address; its button
// stays hidden until its script runs, since it does nothing without it.
import { CONTACT_CHANNELS, NO_PHONE_NOTE } from '../../data/contact';
import PanelHeader from '../molecules/PanelHeader.astro';

const channelCount = `${CONTACT_CHANNELS.length} points de passage`;
---

<section class="contact-channels">
  <PanelHeader label="Canaux" reference={channelCount} />
  <ul>
    {CONTACT_CHANNELS.map((channel) => {
      let rel: string | undefined;
      if (channel.isExternal) {
        rel = 'noopener';
      }
      return (
        <li class="contact-channel">
          <span class="contact-channel-icon" aria-hidden="true">
            {channel.icon}
          </span>
          <span class="contact-channel-text">
            <span class="contact-channel-label">{channel.label}</span>
            <a href={channel.href} rel={rel} data-channel={channel.id}>
              {channel.value}
            </a>
            {channel.id === 'email' && (
              <button
                type="button"
                class="contact-channel-copy"
                data-copy-email={channel.value}
                hidden
              >
                Copier l'adresse
              </button>
            )}
          </span>
          {channel.isExternal && (
            <span class="contact-channel-arrow" aria-hidden="true">
              ↗
            </span>
          )}
        </li>
      );
    })}
  </ul>
  <p class="contact-channels-note">{NO_PHONE_NOTE}</p>
</section>

<script>
  // Copies the address; without clipboard access (permission refused),
  // selects it instead so the visitor can copy it by hand.
  const FEEDBACK_DURATION_MS = 1800;

  const copyButton =
    document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const emailLink = document.querySelector<HTMLAnchorElement>(
    '[data-channel="email"]',
  );

  function selectAddress(): void {
    const selection = window.getSelection();
    if (emailLink === null || selection === null) {
      return;
    }
    const range = document.createRange();
    range.selectNodeContents(emailLink);
    selection.removeAllRanges();
    selection.addRange(range);
  }

  async function copyAddress(button: HTMLButtonElement): Promise<void> {
    const initialLabel = button.textContent;
    let feedback = 'Copiée';
    try {
      await navigator.clipboard.writeText(button.dataset.copyEmail ?? '');
    } catch {
      selectAddress();
      feedback = 'Sélectionnée';
    }
    button.textContent = feedback;
    button.classList.add('is-done');
    window.setTimeout(() => {
      button.textContent = initialLabel;
      button.classList.remove('is-done');
    }, FEEDBACK_DURATION_MS);
  }

  if (copyButton !== null) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', () => copyAddress(copyButton));
  }
</script>

<style>
  .contact-channels ul {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-channel {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px 8px 8px;
    background: var(--color-paper-light);
    border: var(--line);
    transition:
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .contact-channel:hover,
  .contact-channel:focus-within {
    box-shadow: 3px 3px 0 var(--color-ink);
    transform: translate(-1px, -1px);
  }

  .contact-channel-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    font: 700 12px var(--font-mono);
    color: var(--color-paper);
    background: var(--color-ink);
    clip-path: var(--octagon);
  }

  .contact-channel-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .contact-channel-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .contact-channel-text a {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .contact-channel-text a:hover,
  .contact-channel-text a:focus-visible {
    color: var(--color-accent);
  }

  .contact-channel-copy {
    justify-self: start;
    margin-top: 4px;
    padding: 4px 8px;
    font: 11px var(--font-mono);
    white-space: nowrap;
    color: var(--color-ink);
    background: transparent;
    border: var(--line);
    cursor: pointer;
  }

  .contact-channel-copy:hover {
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .contact-channel-copy:focus-visible,
  .contact-channel-text a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact-channel-copy.is-done {
    color: var(--color-ink);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .contact-channel-arrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .contact-channels-note {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-channel {
      transition: none;
    }
  }
</style>
