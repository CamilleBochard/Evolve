---
// Fenêtre « Système » : message d'explication et bouton OK.
import Icon from '../atoms/Icon.astro';
import TerminalWindow from '../molecules/TerminalWindow.astro';

interface Props {
  confirmHref: string;
}

const { confirmHref } = Astro.props;
---

<TerminalWindow
  class="error-notice"
  title="Système"
  titleId="error-notice-title"
>
  <div class="error-notice-body">
    <Icon class="error-notice-icon" name="warning" />
    <p class="error-notice-message">
      <slot />
    </p>
    <a class="error-notice-confirm" href={confirmHref}>
      OK
    </a>
  </div>
</TerminalWindow>

<style>
  .error-notice {
    position: relative;
    z-index: 2;
    width: 220px;
    margin: 40px 0 0 -24px;
  }

  .error-notice-body {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding: 16px 16px 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }

  .error-notice-icon {
    width: 40px;
    height: 40px;
    color: var(--color-accent);
  }

  .error-notice-confirm {
    display: block;
    width: 100%;
    padding: 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-align: center;
    color: var(--color-ink);
    background: var(--color-accent);
  }

  .error-notice-confirm:hover,
  .error-notice-confirm:focus-visible {
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .error-notice-confirm:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .error-notice {
      width: auto;
      margin: 16px 0 0;
    }
  }
</style>
