---
// Portrait of the character column: the halftone paladev on a dark grid,
// a link to the full character sheet.
import paladevPortrait from '../../assets/prints/paladev-portrait.png';
import CornerMarks from '../atoms/CornerMarks.astro';
import PrintImage from '../atoms/PrintImage.astro';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<section class="character-portrait">
  <a class="character-portrait-link" href={href}>
    <PrintImage
      class="character-portrait-print"
      image={paladevPortrait}
      alt="Paladev en gravure tramée orange, devant un soleil à pointes. Ouvrir la fiche du personnage."
    />
    <CornerMarks />
  </a>
  <span class="character-portrait-caption">
    <span>Fig. 01 · Gravure deux encres</span>
    <b>Fiche ↗</b>
  </span>
</section>

<style>
  .character-portrait-link {
    position: relative;
    display: block;
    aspect-ratio: 240 / 340;
    background-color: var(--color-print-paper);
    background-image:
      linear-gradient(var(--color-print-grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-print-grid-major) 1px, transparent 1px);
    background-size: 16px 16px;
    background-position: center;
    border: var(--line);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .character-portrait-link:hover,
  .character-portrait-link:focus-visible {
    border-color: var(--color-accent);
    box-shadow: 4px 4px 0 var(--color-accent);
    outline: none;
  }

  .character-portrait-link :global(.corner-mark) {
    z-index: 1;
    border-color: var(--color-print-bone);
  }

  .character-portrait :global(.character-portrait-print) {
    width: 100%;
    height: 100%;
  }

  .character-portrait-caption {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .character-portrait-caption b {
    font-weight: 400;
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .character-portrait-link {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .character-portrait {
      max-width: 320px;
      margin: 0 auto;
    }
  }
</style>
