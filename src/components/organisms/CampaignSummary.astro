---
// Progress of the campaign: quests done, chapters open, years of career,
// then one box per quest in campaign order.
import { QUESTS, QUEST_CHAPTERS } from '../../data/quests';
import { campaignStats } from '../../lib/journal/campaign';
import PanelHeader from '../molecules/PanelHeader.astro';
import StatTiles from '../molecules/StatTiles.astro';
import type { StatTile } from '../molecules/StatTiles.astro';

const stats = campaignStats();
const tiles: StatTile[] = [
  { value: stats.doneCount, label: `/ ${stats.questCount} quêtes` },
  {
    value: stats.openChapterCount,
    label: `/ ${stats.chapterCount} chapitres`,
  },
  { value: stats.years, label: 'ans de campagne' },
];
const lastChapter = QUEST_CHAPTERS[QUEST_CHAPTERS.length - 1];
const lastChapterLabel = `Chapitre ${lastChapter.numeral}`;
---

<section class="campaign-summary" data-tour="campaign">
  <PanelHeader label="Campagne" reference="2011 → aujourd'hui" />
  <StatTiles tiles={tiles} />
  <div class="campaign-summary-progress">
    <span class="campaign-summary-bar" aria-hidden="true">
      {QUESTS.map((quest) => (
        <i
          class:list={['campaign-summary-box', `is-${quest.status}`]}
          title={quest.title}
        />
      ))}
    </span>
    <span class="campaign-summary-hint" aria-hidden="true">
      <span>Prologue</span>
      <span>{lastChapterLabel}</span>
    </span>
  </div>
</section>

<style>
  .campaign-summary {
    display: grid;
    gap: 10px;
  }

  .campaign-summary-bar {
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: 2px;
  }

  .campaign-summary-box {
    height: 8px;
    border: 1px solid var(--color-ink);
  }

  .campaign-summary-box.is-done {
    background: var(--color-ink);
  }

  .campaign-summary-box.is-progress {
    background: var(--hatch-accent);
    border-color: var(--color-accent);
  }

  .campaign-summary-box.is-locked {
    border-style: dashed;
    border-color: var(--color-ink-soft);
  }

  .campaign-summary-hint {
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
  }
</style>
