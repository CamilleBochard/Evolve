---
// Error poster decor: glitch lines, boxes, ruler, vertical text and gauge.
// Purely decorative, absolutely positioned in the poster. Hidden on mobile
// so it does not get in the way of reading.
---

<div class="error-decor" aria-hidden="true">
  <span class="glitch glitch--accent glitch--1"></span>
  <span class="glitch glitch--ink glitch--2"></span>
  <span class="glitch glitch--faint glitch--3"></span>
  <span class="glitch glitch--accent glitch--4"></span>
  <span class="glitch glitch--ink glitch--5"></span>
  <span class="glitch glitch--accent glitch--6"></span>
  <span class="glitch glitch--faint glitch--7"></span>

  <span class="side-box side-box--left">✕</span>
  <span class="side-box side-box--right">!</span>

  <span class="ruler"></span>
  <span class="side-text">RETRY.CONNECTION.EXE</span>
  <span class="side-gauge"></span>
</div>

<style>
  .error-decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .glitch {
    position: absolute;
    height: 2px;
  }

  .glitch--accent {
    background: var(--color-accent);
  }

  .glitch--ink {
    background: var(--color-ink);
    opacity: 0.55;
  }

  .glitch--faint {
    background: var(--color-ink-faint);
  }

  /* Positions in classes rather than style attributes: the CSP blocks
     inline style attributes. */
  .glitch--1 {
    top: 14%;
    left: 8%;
    width: 90px;
  }

  .glitch--2 {
    top: 15%;
    left: 12%;
    width: 40px;
  }

  .glitch--3 {
    top: 31%;
    right: 6%;
    width: 160px;
  }

  .glitch--4 {
    top: 33%;
    right: 14%;
    width: 30px;
  }

  .glitch--5 {
    top: 47%;
    left: 4%;
    width: 60px;
  }

  .glitch--6 {
    top: 58%;
    right: 9%;
    width: 70px;
  }

  .glitch--7 {
    top: 74%;
    left: 4%;
    width: 110px;
  }

  .side-box {
    position: absolute;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: var(--line);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .side-box--left {
    top: 22%;
    left: 48px;
  }

  .side-box--right {
    top: 54%;
    right: 64px;
  }

  /* Vertical ruler */
  .ruler {
    position: absolute;
    top: 24%;
    left: 22px;
    width: 6px;
    height: 46%;
    background: repeating-linear-gradient(
      var(--color-ink-soft) 0 1px,
      transparent 1px 7px
    );
  }

  .side-text {
    position: absolute;
    top: 26%;
    right: 22px;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
  }

  /* Almost empty vertical gauge */
  .side-gauge {
    position: absolute;
    top: calc(26% + 230px);
    right: 24px;
    width: 10px;
    height: 110px;
    border: var(--line);
  }

  .side-gauge::after {
    content: '';
    position: absolute;
    right: 1px;
    bottom: 1px;
    left: 1px;
    height: 18%;
    background: var(--color-accent);
  }

  /* Short screens: the vertical text would slide under the windows. */
  @media (max-height: 760px) {
    .side-text,
    .side-gauge {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .error-decor {
      display: none;
    }
  }
</style>
