---
// Text logo « CB//V1.0 »; the version after the slashes can change.
interface Props {
  href: string;
  version?: string;
}

const { href, version = 'V1.0' } = Astro.props;
---

<a class="brand" href={href}>
  CB<span class="brand-slash">//</span>
  {version}
</a>

<style>
  .brand {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.04em;
  }

  .brand-slash {
    color: var(--color-accent);
  }
</style>
