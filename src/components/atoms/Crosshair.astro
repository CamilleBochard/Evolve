---
// Decorative crosshair mark. The parent positions it through `class`.
//
// The remaining attributes (including the parent's CSS scope attribute) are
// forwarded to the root element: this is what lets the parent's styles
// apply to the class it passes.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'span'>;

const { class: className, ...attributes } = Astro.props;
---

<span
  class:list={['crosshair', className]}
  aria-hidden="true"
  {...attributes}
></span>

<style>
  .crosshair {
    position: absolute;
    width: 13px;
    height: 13px;
    pointer-events: none;
  }

  .crosshair::before,
  .crosshair::after {
    content: '';
    position: absolute;
    background: var(--color-ink);
  }

  /* Vertical stroke */
  .crosshair::before {
    top: 0;
    left: 6px;
    width: 1px;
    height: 13px;
  }

  /* Horizontal stroke */
  .crosshair::after {
    top: 6px;
    left: 0;
    width: 13px;
    height: 1px;
  }
</style>
