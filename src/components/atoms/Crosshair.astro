---
// Repère en croix décoratif. Le parent le positionne via `class`.
//
// Les autres attributs (dont l'attribut de scope CSS du parent) sont
// transmis à l'élément racine : c'est ce qui permet au style du parent
// de s'appliquer à la classe qu'il passe.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'span'>;

const { class: className, ...attributes } = Astro.props;
---

<span
  class:list={['crosshair', className]}
  aria-hidden="true"
  {...attributes}
></span>

<style>
  .crosshair {
    position: absolute;
    width: 13px;
    height: 13px;
    pointer-events: none;
  }

  .crosshair::before,
  .crosshair::after {
    content: '';
    position: absolute;
    background: var(--color-ink);
  }

  /* Trait vertical */
  .crosshair::before {
    top: 0;
    left: 6px;
    width: 1px;
    height: 13px;
  }

  /* Trait horizontal */
  .crosshair::after {
    top: 6px;
    left: 0;
    width: 13px;
    height: 1px;
  }
</style>
