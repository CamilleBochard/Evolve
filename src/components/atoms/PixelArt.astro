---
// Dessin en pixels à partir d'une grille de texte : « X » = pixel plein,
// tout autre caractère = vide. Toutes les lignes ont la même longueur.
//
// Le slot « behind » reçoit des formes SVG dessinées sous les pixels (un
// fond, par exemple), le slot par défaut des formes dessinées par-dessus.
// Les coordonnées de ces formes sont en pixels de la grille.
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  rows: string[];
  pixelColor: string;
  // Marge autour de la grille, en pixels, pour les formes qui débordent.
  padding?: number;
}

const {
  rows,
  pixelColor,
  padding = 0,
  class: className,
  ...attributes
} = Astro.props;

const FILLED_PIXEL = 'X';

interface Pixel {
  x: number;
  y: number;
}

const pixels: Pixel[] = [];
rows.forEach((row, y) => {
  for (let x = 0; x < row.length; x++) {
    if (row[x] === FILLED_PIXEL) {
      pixels.push({ x, y });
    }
  }
});

const gridWidth = rows[0].length;
const gridHeight = rows.length;
const viewBox = `${-padding} ${-padding} ${gridWidth + padding * 2} ${gridHeight + padding * 2}`;
---

<svg
  class:list={['pixel-art', className]}
  viewBox={viewBox}
  shape-rendering="crispEdges"
  aria-hidden="true"
  {...attributes}
>
  <slot name="behind" />
  {pixels.map((pixel) => (
    <rect x={pixel.x} y={pixel.y} width="1" height="1" fill={pixelColor} />
  ))}
  <slot />
</svg>

<style>
  .pixel-art {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
