---
// Diagonally hatched surface. Size and position come from the parent.
// Remaining attributes are forwarded to the root element (see Crosshair).
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'span'>;

const { class: className, ...attributes } = Astro.props;
---

<span
  class:list={['hatch-block', className]}
  aria-hidden="true"
  {...attributes}
></span>

<style>
  .hatch-block {
    display: block;
    background: var(--hatch);
  }
</style>
