---
// Decorative loading bar: label, percentage, accent-bordered bar.
interface Props {
  label: string;
  percent: number;
}

const { label, percent } = Astro.props;

// SVG width attribute rather than a style attribute: the CSP blocks inline
// style attributes, not SVG presentation attributes.
const fillWidth = `${percent}%`;
---

<div class="loading-bar" aria-hidden="true">
  <div class="loading-bar-legend">
    <span>{label}</span>
    <span>{percent} %</span>
  </div>
  <svg class="loading-bar-track">
    <rect class="loading-bar-fill" width={fillWidth} height="100%"></rect>
  </svg>
</div>

<style>
  .loading-bar {
    display: grid;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .loading-bar-legend {
    display: flex;
    justify-content: space-between;
  }

  .loading-bar-track {
    display: block;
    width: 100%;
    height: 12px;
    border: 1px solid var(--color-accent);
  }

  .loading-bar-fill {
    fill: var(--color-accent);
  }
</style>
