---
// Portrait « analysé » façon logiciel de reconnaissance faciale.
// L'effet (grain, points orange) est déjà dans l'image ; les cadres de visée
// sont dessinés en SVG par-dessus pour rester nets à toutes les tailles.
// Le parent fixe la taille du composant via `class` ; les autres attributs
// sont transmis à l'élément racine (voir Crosshair).
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

import portrait from '../../assets/images/portrait-scan.png';
import MicroText from '../atoms/MicroText.astro';

interface Props extends HTMLAttributes<'figure'> {
  alt: string;
}

const { alt, class: className, ...attributes } = Astro.props;
---

<figure class:list={['scanned-portrait', className]} {...attributes}>
  <div class="scanned-portrait-frame">
    <Image
      class="scanned-portrait-image"
      src={portrait}
      alt={alt}
      widths={[180, 360]}
      sizes="(max-width: 980px) 64vw, 300px"
    />

    <!-- Les coordonnées suivent l'image source (360 x 480). -->
    <svg
      class="scanned-portrait-targets"
      viewBox="0 0 360 480"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      <g fill="none" stroke="currentColor" stroke-width="2">
        <!-- Visage -->
        <rect x="108" y="40" width="130" height="180"></rect>
        <line x1="238" y1="40" x2="360" y2="10"></line>
        <!-- Logo du t-shirt -->
        <rect x="208" y="250" width="56" height="56"></rect>
        <line x1="264" y1="250" x2="360" y2="190"></line>
      </g>
      <rect x="104" y="36" width="9" height="9" fill="currentColor"></rect>
      <rect x="204" y="246" width="8" height="8" fill="currentColor"></rect>
    </svg>
  </div>

  <figcaption class="scanned-portrait-caption">
    <MicroText>ID.CB-01</MicroText>
    <MicroText tone="accent">Match 98 %</MicroText>
  </figcaption>
</figure>

<style>
  .scanned-portrait {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .scanned-portrait-frame {
    position: relative;
    flex: 1;
    min-height: 0;
    padding: 7px;
    background: var(--color-screen);
  }

  .scanned-portrait-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scanned-portrait-targets {
    position: absolute;
    inset: 7px;
    width: calc(100% - 14px);
    height: calc(100% - 14px);
    color: #ff4a1c;
  }

  .scanned-portrait-caption {
    display: flex;
    justify-content: space-between;
    padding-top: 8px;
    border-top: var(--line);
  }
</style>
