---
// CPU load history: one bar per minute, anchored at the bottom.
import MicroText from '../atoms/MicroText.astro';

interface Props {
  values: number[];
}

const { values } = Astro.props;

const MINIMUM_BAR_PERCENT = 3;

const hasValues = values.length > 0;

let maximumText = '--';
if (hasValues) {
  const maximum = Math.max(...values);
  maximumText = `${Math.round(maximum)} %`;
}

// Bars drawn in SVG, in a 100-unit-high box stretched to the plot: their
// size goes through SVG attributes, which the CSP allows, rather than style
// attributes, which it blocks.
const PLOT_HEIGHT = 100;
const BAR_WIDTH = 0.8;

interface Bar {
  x: number;
  y: number;
  height: number;
  description: string;
}

const bars: Bar[] = values.map((value, index) => {
  const minutesAgo = values.length - 1 - index;
  const height = Math.max(value, MINIMUM_BAR_PERCENT);
  const description = `il y a ${minutesAgo} min : ${Math.round(value)} %`;
  const x = index + (1 - BAR_WIDTH) / 2;
  const y = PLOT_HEIGHT - height;
  const bar = { x, y, height, description };
  return bar;
});
---

<div class="cpu-history">
  <div class="cpu-history-header">
    <MicroText>Charge CPU · 30 dernières minutes</MicroText>
    <MicroText>max {maximumText}</MicroText>
  </div>

  {hasValues && (
    <svg
      class="cpu-history-plot"
      viewBox={`0 0 ${values.length} ${PLOT_HEIGHT}`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {bars.map((bar) => (
        <rect
          class="cpu-history-bar"
          x={bar.x}
          y={bar.y}
          width={BAR_WIDTH}
          height={bar.height}
        >
          <title>{bar.description}</title>
        </rect>
      ))}
    </svg>
  )}

  {!hasValues && (
    <div class="cpu-history-plot cpu-history-plot--empty">
      <MicroText>Aucune donnée pour l'instant</MicroText>
    </div>
  )}
</div>

<style>
  .cpu-history {
    display: grid;
    gap: 8px;
  }

  .cpu-history-header {
    display: flex;
    justify-content: space-between;
  }

  .cpu-history-plot {
    display: block;
    width: 100%;
    height: clamp(36px, 5.6vh, 56px);
    border-bottom: var(--line);
    background-image: linear-gradient(
      var(--color-ink-faint) 1px,
      transparent 1px
    );
    background-size: 100% 50%;
  }

  .cpu-history-plot--empty {
    display: grid;
    place-items: center;
    background-image: none;
  }

  .cpu-history-bar {
    fill: var(--color-ink);
  }

  .cpu-history-bar:hover {
    fill: var(--color-accent);
  }
</style>
