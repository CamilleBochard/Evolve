---
// Game menu style button: label on a solid background, arrow, hatched box.
import HatchBlock from '../atoms/HatchBlock.astro';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="game-button" href={href}>
  <span class="game-button-label">
    {label}
    <span class="game-button-arrow" aria-hidden="true">
      ▸
    </span>
  </span>
  <HatchBlock class="game-button-hatch" />
</a>

<style>
  .game-button {
    display: inline-flex;
    align-items: stretch;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .game-button-label {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    color: var(--color-paper);
    background: var(--color-ink);
    clip-path: var(--chamfer);
  }

  .game-button-arrow {
    color: var(--color-accent);
  }

  .game-button-hatch {
    width: 26px;
    margin-left: 4px;
    border: var(--line);
  }

  .game-button:hover .game-button-label,
  .game-button:focus-visible .game-button-label {
    color: var(--color-ink);
    background: var(--color-accent);
  }

  .game-button:hover .game-button-arrow,
  .game-button:focus-visible .game-button-arrow {
    color: var(--color-ink);
  }

  .game-button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
