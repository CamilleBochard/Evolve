---
// Action link on one row: icon, label, hint, arrow.
import Icon from '../atoms/Icon.astro';
import type { IconName } from '../atoms/icon-name';

interface Props {
  href: string;
  icon: IconName;
  label: string;
  hint: string;
  isPrimary?: boolean;
}

const { href, icon, label, hint, isPrimary = false } = Astro.props;
---

<a
  class:list={['action-link', { 'action-link--primary': isPrimary }]}
  href={href}
>
  <Icon class="action-link-icon" name={icon} />
  <span class="action-link-text">
    {label}
    <small class="action-link-hint">{hint}</small>
  </span>
  <span class="action-link-arrow" aria-hidden="true">
    ▸
  </span>
</a>

<style>
  .action-link {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 9px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .action-link-hint {
    display: block;
    font-size: 10px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink-soft);
  }

  .action-link-arrow {
    color: var(--color-accent);
  }

  .action-link--primary .action-link-icon {
    color: var(--color-accent);
  }

  .action-link:hover,
  .action-link:focus-visible {
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .action-link:hover .action-link-hint,
  .action-link:focus-visible .action-link-hint {
    color: var(--color-paper);
  }

  .action-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
</style>
