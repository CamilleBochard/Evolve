---
// Service status: name, bullet and label. The bullet turns accent when the
// service is down; the label stays readable without the color.
import type { VpsService } from '../../data/vps-status';
import OctagonDot from '../atoms/OctagonDot.astro';
import DataRow from './DataRow.astro';

interface Props {
  service: VpsService;
}

const { service } = Astro.props;

let dotTone: 'ink' | 'accent' = 'ink';
if (service.state === 'down') {
  dotTone = 'accent';
}
---

<DataRow term={service.name}>
  <OctagonDot tone={dotTone} />
  {service.detail}
</DataRow>
