---
// Temporary home page template: two columns inside the V4 frame.
// - "panels" slot: stacked panels of the left column;
// - "stage" slot: the right column.
import FrameTemplate from './FrameTemplate.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<FrameTemplate
  title={title}
  description={description}
  leftGutterText="SECTOR 01 // CHANTIER"
  rightGutterText="SECTOR 02 // CHANTIER"
  footerLabel="Page temporaire"
>
  <div class="chantier">
    <div class="chantier-panels">
      <slot name="panels" />
    </div>
    <slot name="stage" />
  </div>
</FrameTemplate>

<style>
  .chantier {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    height: 100%;
  }

  /*
   * Left column: identity at the top, status in the middle (takes the
   * remaining space), contact at the bottom, separated by a line.
   * container-type lets the panels size themselves on its width.
   */
  .chantier-panels {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-width: 0;
    min-height: 0;
    border-right: var(--line);
    container-type: inline-size;
  }

  .chantier-panels > :global(*) {
    min-width: 0;
    min-height: 0;
    padding: clamp(16px, 2.8vh, 28px) 32px;
    border-bottom: var(--line);
  }

  .chantier-panels > :global(*:last-child) {
    border-bottom: 0;
  }

  @media (max-width: 980px) {
    .chantier {
      grid-template-columns: 1fr;
      height: auto;
    }

    .chantier-panels {
      border-right: 0;
      border-bottom: var(--line);
    }
  }

  @media (max-width: 720px) {
    .chantier-panels > :global(*) {
      padding: 22px 16px;
    }
  }
</style>
