---
// Menu template: a full-window pause screen, without the frame of the
// other pages. The dark gridded print covers the window; the corners hold
// what the bars show elsewhere.
// The wheel, centered, sets data-wheel-ready once it can be used: until
// then, the list of links stands in for it on desktop.
// --menu-wheel-size: the size of the wheel, for the wheel component.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { MenuVersion } from '../../data/menu';
import MenuBackBlock from '../organisms/MenuBackBlock.astro';
import MenuFooter from '../organisms/MenuFooter.astro';
import MenuIdentity from '../organisms/MenuIdentity.astro';
import MenuList from '../organisms/MenuList.astro';
import MenuWheelMount from '../organisms/MenuWheelMount.astro';

interface Props {
  title: string;
  description: string;
  version: MenuVersion;
  isIndexable?: boolean;
}

const { title, description, version, isIndexable = true } = Astro.props;
---

<BaseLayout title={title} description={description} isIndexable={isIndexable}>
  <main class="menu-stage" aria-label="Menu principal">
    <i class="menu-crop menu-crop--top-left" aria-hidden="true"></i>
    <i class="menu-crop menu-crop--top-right" aria-hidden="true"></i>
    <i class="menu-crop menu-crop--bottom-left" aria-hidden="true"></i>
    <i class="menu-crop menu-crop--bottom-right" aria-hidden="true"></i>

    <MenuIdentity />
    <MenuBackBlock version={version} />
    <MenuWheelMount version={version} />
    <MenuList />
    <MenuFooter />
  </main>
</BaseLayout>

<style>
  /* The labels stick out of the wheel: about 13 % of its size in height,
     36 % in width, plus the width of the longest name on each side. */
  .menu-stage {
    --menu-wheel-size: min(
      calc((100vh - 120px) * 0.88),
      calc((100vw - 320px) / 1.36)
    );

    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: var(--color-print-bone);
    background-color: var(--color-print-paper);
    background-image:
      linear-gradient(var(--color-print-grid-major) 1px, transparent 1px),
      linear-gradient(
        90deg,
        var(--color-print-grid-major) 1px,
        transparent 1px
      ),
      linear-gradient(var(--color-print-grid-minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-print-grid-minor) 1px, transparent 1px);
    background-position: center;
    background-size:
      160px 160px,
      160px 160px,
      32px 32px,
      32px 32px;
  }

  /* Darker towards the edges, like the vignette of a print. */
  .menu-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      transparent 50%,
      rgba(0, 0, 0, 0.6) 100%
    );
    pointer-events: none;
  }

  .menu-crop {
    position: absolute;
    z-index: 3;
    width: 18px;
    height: 18px;
    border: 0 solid var(--color-print-bone-soft);
  }

  .menu-crop--top-left {
    top: 12px;
    left: 12px;
    border-width: 1px 0 0 1px;
  }

  .menu-crop--top-right {
    top: 12px;
    right: 12px;
    border-width: 1px 1px 0 0;
  }

  .menu-crop--bottom-left {
    bottom: 12px;
    left: 12px;
    border-width: 0 0 1px 1px;
  }

  .menu-crop--bottom-right {
    right: 12px;
    bottom: 12px;
    border-width: 0 1px 1px 0;
  }

  /* Desktop: the wheel replaces the list once it is ready. */
  @media (min-width: 721px) {
    .menu-stage:has([data-wheel-ready]) > :global(.menu-list) {
      display: none;
    }
  }

  /* Phones: the page scrolls, the corners come back into the flow, the
     list leads. */
  @media (max-width: 720px) {
    .menu-stage {
      position: relative;
      inset: auto;
      display: block;
      min-height: 100vh;
      padding: 24px 16px 28px;
    }

    .menu-crop {
      position: fixed;
    }

    .menu-stage > :global(.menu-list) {
      margin-top: 26px;
    }
  }
</style>
